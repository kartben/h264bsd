menuconfig H264BSD
	bool "h264bsd H.264 decoder"
	depends on ZEPHYR_H264BSD_MODULE
	help
	  Decode H.264 video in software: the Baseline profile, and the High
	  profile as hardware encoders use it for game streaming with CABAC
	  turned off, that is 8-bit 4:2:0 progressive video coded with CAVLC,
	  without B slices or weighted prediction.

	  On an Armv8.1-M core with Helium the filters and interpolators are
	  vectorised automatically; the ESP32-S3 has H264BSD_PIE; everywhere
	  else the plain C is built.

if H264BSD

config H264BSD_PIE
	bool "Use the ESP32-S3 vector instructions"
	depends on SOC_SERIES_ESP32S3
	default y
	help
	  Run the pixel kernels (motion compensated interpolation and the
	  writing of macroblocks) on the Processor Instruction Extensions of
	  the ESP32-S3, coprocessor 3, sixteen bytes at a time. The kernels
	  are checked against the C code when the decoder is initialised and
	  are only used when they agree with it.

	  The kernel does not save the vector registers on a context switch,
	  so each macroblock's prediction runs with the scheduler locked;
	  nothing that runs in an interrupt may use the unit.

config H264BSD_HOT_SECTION
	string "Section for the tables read at every block"
	default ".dram1" if SOC_FAMILY_ESPRESSIF_ESP32
	default ""
	help
	  The decoder's constant tables normally sit in flash with the code.
	  The ones read for every block or macroblock, about 6 KB (the CAVLC
	  code tables, the deblocking thresholds, the neighbour maps and the
	  like), can be placed in a section of internal RAM instead, so that
	  they are not fetched again and again through a cache that the
	  pictures are streaming through. Empty leaves them with the code.

config H264BSD_MALLOC
	string "Name of the function the decoder allocates through"
	default "malloc"
	help
	  The decoder allocates its reference pictures once, when the stream
	  dimensions become known, and they are large: a megabyte or so at
	  800x480. Name a function of your own here to place them somewhere
	  other than the libc heap.

config H264BSD_PICTURE_MALLOC
	string "Name of the function the decoder allocates pictures through"
	default "malloc"
	help
	  The decoded pictures dwarf everything else the decoder holds, and a
	  part whose fast memory cannot take them can still keep the rest of
	  the decoder's state there. Name a function of your own to place the
	  pictures on their own; the default sends them wherever
	  H264BSD_MALLOC sends the rest.

config H264BSD_PICTURE_FREE
	string "Name of the function the decoder releases pictures through"
	default "free"
	help
	  Releases what H264BSD_PICTURE_MALLOC returned.

config H264BSD_FREE
	string "Name of the function the decoder releases memory through"
	default "free"
	help
	  Releases what H264BSD_MALLOC returned.

endif # H264BSD
